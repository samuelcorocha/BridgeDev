# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=        # openssl rand -base64 32

# GitHub OAuth App (github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App (github.com/settings/apps)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY= # PEM em uma linha com \n
GITHUB_APP_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=  # openssl rand -hex 20

# Organização GitHub dos templates de desafio
GITHUB_ORG=bridgedev-challenges

# Supabase (Transaction mode port 6543 para URL, porta 5432 para DIRECT)
DATABASE_URL=postgresql://postgres:[password]@[host]:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Inngest (inngest.com)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
